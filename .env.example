# ==============================================================================
# MacroCompass (Edición Growth & Tech) - Variables de entorno
# Copia este archivo a .env y completa las claves que necesites.
# ==============================================================================

# FRED API Key (gratuita en https://fred.stlouisfed.org/docs/api/api_key.html)
# Si se deja vacía, la app usa automáticamente fallback al CSV público de FRED
# (Nota: las series ICE BofA HY/BBB en CSV público cubren los últimos ~3 años;
#  con FRED_API_KEY se obtiene el historial completo de 10+ años).
FRED_API_KEY=

# Telegram Bot (para alertas automáticas de alerts.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email SMTP opcional (dejar vacío si solo usas Telegram)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Configuración opcional de caché y servidor
CACHE_TTL_HOURS=4
BACKEND_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
